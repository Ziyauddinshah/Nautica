{
  "name": "nautica-react",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Nautica boat booking frontend built with React and Vite",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "test": "vitest run && node --test server/*.test.js",
    "test:watch": "vitest",
    "server": "node --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "admin:create": "node --env-file-if-exists=.env scripts/admin-create.js",
    "test:server": "node --test server/*.test.js",
    "email:verify": "node --env-file-if-exists=.env scripts/email-verify.js",
    "production:check": "node --env-file-if-exists=.env scripts/production-check.js",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.js",
    "db:status": "node --env-file-if-exists=.env scripts/db-status.js",
    "share": "npm run build && node --env-file-if-exists=.env scripts/share.js",
    "mongo:local": "node --env-file-if-exists=.env scripts/mongo-local.js",
    "test:mongodb": "node --test integration/mongodb.test.js",
    "db:migrate:sqlite": "node --env-file-if-exists=.env scripts/migrate-sqlite.js",
    "sqlite:backup": "node --env-file-if-exists=.env scripts/backup.js",
    "sqlite:restore": "node --env-file-if-exists=.env scripts/db-restore.js",
    "db:connect": "node --env-file-if-exists=.env scripts/db-connect.js",
    "db:backfill:payments": "node --env-file-if-exists=.env scripts/backfill-payments.js",
    "sms:verify": "node --env-file-if-exists=.env scripts/sms-verify.js",
    "jobs:run": "node --env-file-if-exists=.env scripts/aftercare-run.js",
    "admin:mfa:reset": "node --env-file-if-exists=.env scripts/admin-mfa-reset.js",
    "db:backup": "node --env-file-if-exists=.env scripts/mongo-backup.js",
    "db:restore:test": "node --env-file-if-exists=.env scripts/mongo-restore-test.js",
    "test:recovery": "node --test integration/recovery.test.js",
    "pilot:simulate": "node scripts/pilot-simulate.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:check": "node scripts/check-boundaries.js",
    "docs:generate": "node scripts/file-reference.js",
    "docs:check": "node scripts/file-reference.js --check"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "mongodb": "^7.9.1",
    "nodemailer": "^10.6.0",
    "qrcode-generator": "1.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.2.0",
    "mongodb-memory-server-core": "^11.3.0",
    "prettier": "3.6.2",
    "smtp-server": "^3.21.6",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
