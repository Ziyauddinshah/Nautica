# Copy to .env and keep it private. Node 24 is recommended.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
STORAGE_PROVIDER=mongodb
# Local TEST replica set only. Start with npm run mongo:local, then db:init.
# Production: set the online Atlas connection string, explicit DB name and NODE_ENV=production.
# Credentials MUST stay server-side; never use VITE_ for database/provider secrets.


# MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# MONGODB_DB=nautica_test

MONGODB_USERNAME="ziyauddin270499_db_user"
