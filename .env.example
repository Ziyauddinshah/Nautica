# Optional local settings. Copy to .env and keep that file private.
HOST=127.0.0.1
PORT=3001
# Keep the database outside the publicly served dist folder.
NAUTICA_DB=data/nautica.sqlite
NAUTICA_BOOKING_MODE=seats
# Set to your HTTPS origin when deploying behind a reverse proxy.
PUBLIC_ORIGIN=http://localhost:3000
# Change to your HTTPS origin before deployment, e.g. https://nautica.example.com
# NODE_ENV=production
# Create an admin interactively with npm run admin:create.

# Gmail SMTP confirmations. Never commit the real .env file.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Use a Google App Password, not your normal Google account password.
SMTP_PASS=
# Admin notification recipient (may be different from the sender).
SMTP_ADMIN_TO=
# Optional PUBLIC_ORIGIN above adds a link to /admin in admin emails.
# Port 465 uses TLS; port 587 uses mandatory STARTTLS.

# Local demo only. Production accepts disabled or razorpay, never demo.
PAYMENT_MODE=demo
# Set PAYMENT_MODE=razorpay to use hosted Razorpay Checkout.
# Only the key ID is returned to checkout; secrets always stay on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Configure auto-capture in Razorpay Dashboard and subscribe to
# payment.captured and order.paid at /api/payments/razorpay/webhook.
# Optional exact socket IPs of your controlled HTTPS proxy (not arbitrary clients).
TRUSTED_PROXY_IPS=
