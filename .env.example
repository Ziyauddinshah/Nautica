uri="mongodb+srv://ziyauddin270499_db_user:tnnOKG6aW2AzqlVf@ziyacluster1.djg832q.mongodb.net"
database="boat_project"
production=false
NAUTICA_BOOKING_MODE=seats
PUBLIC_ORIGIN=http://localhost:3000

# Local demo only. Production permits disabled or razorpay, never demo.
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Enable capture and subscribe to payment.captured/order.paid at
# https://YOUR_DOMAIN/api/payments/razorpay/webhook.

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ziya.btech1998@gmail.com
# Gmail App Password, not the normal account password.
