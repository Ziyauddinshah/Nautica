# Copy to .env and keep it private. Node 24 is recommended.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
STORAGE_PROVIDER=mongodb
# Atlas example below; the commented local replica set is for testing only.
# Production: use your online Atlas URI, explicit DB name and NODE_ENV=production.
# Credentials MUST stay server-side; never use VITE_ for database/provider secrets.


# MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
# MONGODB_DB=nautica_test

MONGODB_URI=mongodb+srv://YOUR_DB_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=boat_project
NAUTICA_BOOKING_MODE=seats
PUBLIC_ORIGIN=http://localhost:3000

# Local demo only. Production permits disabled or razorpay, never demo.
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Enable capture and subscribe to payment.captured/order.paid at
# https://YOUR_DOMAIN/api/payments/razorpay/webhook.

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Gmail App Password, not the normal account password.
SMTP_PASS=
SMTP_ADMIN_TO=

# Optional explicitly trusted reverse-proxy IPs. Other forwarded IP headers are ignored.
TRUSTED_PROXY_IPS=
# Compose HTTPS deployment uses a secret proxy token instead of fixed container IPs.
# Generate a random token of at least 32 characters. Caddy injects it server-side.
NAUTICA_PROXY_TOKEN=
# NAUTICA_DOMAIN=your-real-hostname.example

# Legacy SQLite migration/backup tools ONLY; never used by the application runtime.
# NAUTICA_DB=/absolute/path/to/original/nautica.sqlite

# TextBee transactional SMS (server only). No keys/device IDs in VITE_ variables.
# Enable only for future bookings after configuring the registered Android phone.
SMS_ENABLED=false
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Optional admin destination. Use E.164, e.g. +919876543210 (not the sending phone).
SMS_ADMIN_TO=
# Only Indian 10-digit local numbers are expanded when this is 91.
# For other countries use explicit international +countrycode numbers.
SMS_DEFAULT_COUNTRY_CODE=91

# Private malware scanner for boat document uploads. Required in production.
# Keep clamd on a trusted private network; never expose port 3310 publicly.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Boat-owner mobile OTP verification: one shared secret across all replicas.
# Generate at least 32 random bytes privately; never put this in VITE_* variables.
MOBILE_OTP_SECRET=
# Merchant-controlled bridge to an authorized identity verification provider.
# Aadhaar and alternative verification are hosted there; Nautica collects no Aadhaar number.
# Leave unset to disable identity verification and block new boat registrations.
IDENTITY_BRIDGE_URL=
IDENTITY_BRIDGE_KEY=
IDENTITY_CHECKOUT_ORIGIN=

# Full refund for eligible requests at least 24 hours before departure; admin approval required.
# Use the same policy on every replica. Existing bookings keep their policy snapshot.
CANCELLATION_CUTOFF_HOURS=24
# Shared hourly expiry scan; run on every replica safely. SMTP/TextBee settings above apply.
DOCUMENT_REMINDERS_ENABLED=true

# Mandatory admin authenticator encryption: generate 32 random bytes privately as 64 hex chars.
# Share the same key across replicas; keep it out of VITE_*, Git and client configuration.
ADMIN_MFA_ENCRYPTION_KEY=
# Optional independent HTTPS receiver for sanitized operational incident events.
# Receiver must deduplicate by eventId / Idempotency-Key. Never expose these to the browser.
OPERATIONS_WEBHOOK_URL=
OPERATIONS_WEBHOOK_KEY=
# Optional non-sensitive unique app alias per replica (e.g. app-1). Defaults to hashed hostname.
OPS_INSTANCE_ID=
# Optional non-sensitive environment namespace, distinct for staging and production.
# Otherwise durable alerts are namespaced by the initialized database identity.
OPS_APPLICATION_ID=
OPERATIONS_ALERT_LANGUAGE=en
