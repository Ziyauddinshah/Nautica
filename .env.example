SMTP_ADMIN_TO=ziyauddin270499@gmail.com

# Optional explicitly trusted reverse-proxy IPs. Other forwarded IP headers are ignored.
TRUSTED_PROXY_IPS=
# Compose HTTPS deployment uses a secret proxy token instead of fixed container IPs.
# Generate a random token of at least 32 characters. Caddy injects it server-side.
NAUTICA_PROXY_TOKEN=
# NAUTICA_DOMAIN=your-real-hostname.example

